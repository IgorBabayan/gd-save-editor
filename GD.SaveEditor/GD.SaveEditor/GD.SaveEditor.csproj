<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- Avalonia UI: one build for Windows, Linux and macOS (win-x64, linux-x64, osx-x64, osx-arm64). -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Major.Minor for releases; CI appends the build number as the patch part. -->
        <VersionPrefix>0.1.0</VersionPrefix>
        <ApplicationIcon>App.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- Bindings are compiled (checked at build time, no reflection at run time) unless a binding opts out. -->
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <!-- Icons are copied straight from the decoded pixel buffers. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Faster start-up of the self-contained builds. -->
        <TieredPGO>true</TieredPGO>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
      <AvaloniaResource Include="App.ico" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia" Version="12.1.3" />
      <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
      <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="Material.Icons" Version="3.0.3-nightly.0.2" />
      <PackageReference Include="Material.Icons.Avalonia" Version="3.0.3-nightly.0.2" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.2.26504.105" />
      <!-- database.db (game records, texts, resource index) generated by the database button. -->
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
      <!-- Records of the .arz databases and parts of the .arc archives are LZ4 block compressed. -->
      <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <!-- Major.Minor for releases; CI appends the build number as the patch part. -->
        <VersionPrefix>0.1.0</VersionPrefix>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="Material.Icons" Version="3.0.3-nightly.0.2" />
      <PackageReference Include="Material.Icons.WPF" Version="3.0.3-nightly.0.2" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.2.26504.105" />
      <!-- database.db (game records, texts, resource index) generated by the database button. -->
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
      <!-- Records of the .arz databases and parts of the .arc archives are LZ4 block compressed. -->
      <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    </ItemGroup>

</Project>

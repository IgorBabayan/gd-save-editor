<UserControl x:Class="GD.SaveEditor.Presentation.Views.Characters.CharacterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:charactersVm="clr-namespace:GD.SaveEditor.Presentation.ViewModels.Characters"
             xmlns:local="clr-namespace:GD.SaveEditor.Presentation.Views.Characters"
             xmlns:inventoryViews="clr-namespace:GD.SaveEditor.Presentation.Views.Inventory"
             xmlns:waypointsViews="clr-namespace:GD.SaveEditor.Presentation.Views.Waypoints"
             xmlns:factionsViews="clr-namespace:GD.SaveEditor.Presentation.Views.Factions"
             xmlns:stashViews="clr-namespace:GD.SaveEditor.Presentation.Views.Stash"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=charactersVm:CharacterViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="700" d:DesignWidth="900">

    <!--
        Details of the selected character. The TabControl itself stays the same while the selection changes
        (only its DataContext is replaced), so the open tab is kept when switching between characters.
    -->
    <TabControl x:Name="Tabs" Style="{StaticResource UnderlineTabControlStyle}">
        <!--
            Equipment and attributes, with the bags under them like in the game; both scroll together.
            The page is centered and as wide as its widest part, so the bags card lines up with the row above it.
        -->
        <TabItem x:Name="CharacterTab" Header="Character">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center">
                    <local:CharacterEquipmentView DataContext="{Binding Equipment}" />
                    <inventoryViews:InventoryView DataContext="{Binding Inventory}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Personal stash tabs 1 to 8 and the shared stash of the character's mode. -->
        <TabItem x:Name="StashTab" Header="Stash">
            <stashViews:StashView DataContext="{Binding Stash}" />
        </TabItem>

        <TabItem x:Name="WaypointsTab" Header="Waypoints">
            <waypointsViews:WaypointsView DataContext="{Binding Waypoints}" />
        </TabItem>

        <TabItem x:Name="FactionsTab" Header="Factions">
            <factionsViews:FactionsView DataContext="{Binding Factions}" />
        </TabItem>
    </TabControl>
</UserControl>

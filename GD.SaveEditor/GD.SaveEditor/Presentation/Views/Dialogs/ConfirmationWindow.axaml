<Window x:Class="GD.SaveEditor.Presentation.Views.Dialogs.ConfirmationWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Name="Root"
        Title="Confirm"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid RowDefinitions="32,*,Auto">

            <!-- ===== Title bar ===== -->
            <Panel Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" WindowDecorationProperties.ElementRole="TitleBar">
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding #Root.Title}" />
                <!-- Same as "No". -->
                <Button HorizontalAlignment="Right"
                        Theme="{StaticResource CloseCaptionButtonStyle}"
                        WindowDecorationProperties.ElementRole="User"
                        ToolTip.Tip="Close"
                        Click="OnNoClick">
                    <mi:MaterialIcon Kind="WindowClose" Width="16" Height="16" />
                </Button>
            </Panel>

            <!-- ===== Message ===== -->
            <Grid Grid.Row="1" Margin="20,20,20,24" ColumnDefinitions="Auto,*">
                <mi:MaterialIcon Grid.Column="0"
                                 Width="24"
                                 Height="24"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Top"
                                 Kind="HelpCircleOutline"
                                 Foreground="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="MessageText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>

            <!-- ===== Footer ===== -->
            <Border Grid.Row="2"
                    Padding="20,12"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="YesButton"
                            Theme="{StaticResource AccentButtonStyle}"
                            Content="_Yes"
                            IsDefault="True"
                            Click="OnYesClick" />
                    <!-- IsCancel: Escape also answers "No". -->
                    <Button Margin="8,0,0,0"
                            Theme="{StaticResource DialogButtonStyle}"
                            Content="_No"
                            IsCancel="True"
                            Click="OnNoClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

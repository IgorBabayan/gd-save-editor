<UserControl x:Class="GD.SaveEditor.Presentation.Views.Inventory.ItemInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:inventoryVm="clr-namespace:GD.SaveEditor.Presentation.ViewModels.Inventory"
             xmlns:wpf="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:converters="clr-namespace:GD.SaveEditor.Presentation.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=inventoryVm:ItemBuilderViewModel, IsDesignTimeCreatable=False}"
             Width="460"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             Foreground="{DynamicResource WindowForegroundBrush}">

    <!--
        Compact item builder shown next to a bag item, laid out like an object inspector (as in the Last Epoch editor):
        a name column and a value column; rows with a chevron expand into sub-properties (category and rarity pills,
        the item list, the stats of a part with its picker, the game's tooltip).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GD.SaveEditor;component/Presentation/Views/Characters/ItemResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:AllTrueToVisibilityConverter x:Key="AllTrueToVisibilityConverter" />

            <!-- Width of the name column; values start right after it. -->
            <GridLength x:Key="InspectorNameWidth">170</GridLength>
            <Thickness x:Key="InspectorValueMargin">178,0,6,0</Thickness>
            <Thickness x:Key="IndentLevel1">14,0,0,0</Thickness>
            <Thickness x:Key="IndentLevel2">28,0,0,0</Thickness>

            <!-- Read-only (or input) row: Header in the name column, Content in the value column. Padding indents the name. -->
            <Style x:Key="InspectorRowStyle" TargetType="HeaderedContentControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="HeaderedContentControl">
                            <Border MinHeight="26"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource InspectorNameWidth}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            BorderThickness="0,0,1,0"
                                            BorderBrush="{DynamicResource ControlBorderBrush}">
                                        <Border Margin="{TemplateBinding Padding}" Padding="22,4,6,4">
                                            <ContentPresenter VerticalAlignment="Center" ContentSource="Header" />
                                        </Border>
                                    </Border>
                                    <ContentPresenter Grid.Column="1" Margin="8,3,6,3" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Expandable row: the whole row toggles, a chevron shows the state. The value is laid over the row
                (InspectorValueMargin) by the parent grid, so it can hold its own buttons.
            -->
            <Style x:Key="InspectorExpanderStyle" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd"
                                    MinHeight="26"
                                    Background="Transparent"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource InspectorNameWidth}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            BorderThickness="0,0,1,0"
                                            BorderBrush="{DynamicResource ControlBorderBrush}">
                                        <DockPanel Margin="{TemplateBinding Padding}">
                                            <wpf:MaterialIcon x:Name="Chevron"
                                                              DockPanel.Dock="Left"
                                                              Width="14"
                                                              Height="14"
                                                              Margin="4,0,0,0"
                                                              VerticalAlignment="Center"
                                                              Kind="ChevronRight"
                                                              Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                            <ContentPresenter Margin="4,4,6,4" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chevron" Property="Kind" Value="ChevronDown" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}" />
                                </Trigger>
                                <!-- Nothing to expand (e.g. an empty part): no chevron, the label keeps its place. -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Panel under an expanded row (pills, item list, part picker, tooltip). -->
            <Style x:Key="InspectorDropDownBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="8" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            </Style>

            <!-- Small link button inside a value cell. -->
            <Style x:Key="InspectorLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource TextLinkButtonStyle}">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- A category / rarity pill: rarity pills have a dot in the rarity's color. -->
            <Style x:Key="FilterPillButtonStyle" TargetType="Button">
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Padding="10,4"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding DotRarity, Converter={StaticResource RarityBrush}}"
                                             Visibility="{Binding HasDot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock x:Name="Text"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource WindowForegroundBrush}"
                                               Text="{Binding Name}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                                </Trigger>
                                <!-- Declared last so the selected look wins over hover. -->
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                    <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Items grouped by type, picker entries by kind. -->
            <CollectionViewSource x:Key="GroupedOptions" Source="{Binding Options}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="GroupName" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <CollectionViewSource x:Key="GroupedPickerOptions" Source="{Binding PickerOptions}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="GroupName" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <GroupStyle x:Key="ListGroupStyle">
                <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Margin="8,8,8,2"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="{Binding Name}" />
                    </DataTemplate>
                </GroupStyle.HeaderTemplate>
            </GroupStyle>

            <!-- Picker shown under the part being filled (DataContext: ItemPartSlotViewModel). -->
            <DataTemplate x:Key="PartPickerTemplate" DataType="{x:Type inventoryVm:ItemPartSlotViewModel}">
                <Border Style="{StaticResource InspectorDropDownBorderStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource InspectorLinkButtonStyle}"
                                    Content="Cancel"
                                    Command="{Binding DataContext.ClosePickerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBox Padding="6,3"
                                     AutomationProperties.Name="Search parts"
                                     ToolTip="Search by name, stat or record"
                                     Text="{Binding DataContext.PickerSearchText, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Loaded="OnPickerSearchLoaded" />
                        </DockPanel>
                        <Grid>
                            <ListBox MaxHeight="260"
                                     ItemsSource="{Binding Source={StaticResource GroupedPickerOptions}}"
                                     SelectedItem="{Binding DataContext.SelectedPickerOption, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     IsSynchronizedWithCurrentItem="False"
                                     Style="{StaticResource PlainListBoxStyle}"
                                     ItemContainerStyle="{StaticResource ListRowItemStyle}"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                                <ListBox.GroupStyle>
                                    <StaticResource ResourceKey="ListGroupStyle" />
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type inventoryVm:PartOptionViewModel}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}"
                                                           Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           FontSize="11"
                                                           Style="{StaticResource SecondaryTextStyle}"
                                                           Text="{Binding Details}" />
                                            </Grid>
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       Text="{Binding Summary}"
                                                       Visibility="{Binding HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="8,12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Nothing matches the search."
                                       Visibility="{Binding DataContext.HasPickerOptions, Converter={StaticResource InverseBooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="{Binding DataContext.PickerLimitText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Visibility="{Binding DataContext.HasPickerLimitText, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- One part: label + its name (or "Add prefix"); expands into its stats. -->
            <DataTemplate x:Key="PartRowTemplate" DataType="{x:Type inventoryVm:ItemPartSlotViewModel}">
                <StackPanel>
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Style="{StaticResource InspectorExpanderStyle}"
                                      Padding="{StaticResource IndentLevel1}"
                                      IsChecked="True"
                                      IsEnabled="{Binding HasSummary}">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                        </ToggleButton>

                        <!-- Value: the part's name with Change / Remove, or "Add …" for an empty slot. -->
                        <DockPanel Margin="{StaticResource InspectorValueMargin}" LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource InspectorLinkButtonStyle}"
                                    Content="Remove"
                                    Command="{Binding RemoveCommand}"
                                    Visibility="{Binding HasPart, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource InspectorLinkButtonStyle}"
                                    Content="Change"
                                    Command="{Binding ChooseCommand}"
                                    Visibility="{Binding HasPart, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button HorizontalAlignment="Left"
                                    Margin="-6,0,0,0"
                                    Style="{StaticResource InspectorLinkButtonStyle}"
                                    Content="{Binding AddText}"
                                    Command="{Binding ChooseCommand}"
                                    Visibility="{Binding HasPart, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <TextBlock VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}"
                                       Text="{Binding Name}"
                                       Visibility="{Binding HasPart, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </DockPanel>
                    </Grid>

                    <!-- Sub-property: the stats of the part on one line. -->
                    <Border Padding="50,4,8,4"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlBorderBrush}">
                        <Border.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueToVisibilityConverter}">
                                <Binding Path="IsChecked" ElementName="Toggle" />
                                <Binding Path="HasSummary" />
                            </MultiBinding>
                        </Border.Visibility>
                        <TextBlock FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TooltipStatBrush}"
                                   Text="{Binding Summary}" />
                    </Border>

                    <!-- The picker exists only for the part being filled (one list, one selection binding). -->
                    <ContentControl Focusable="False" Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{x:Null}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPicking}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource PartPickerTemplate}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ApplyCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <!-- Shadow on its own layer: an effect on the content would turn off ClearType for every text in it. -->
        <Border CornerRadius="8" Background="{DynamicResource WindowBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="Black" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{Binding HeaderRarity, Converter={StaticResource RarityBrush}}"
                Background="{DynamicResource WindowBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== Header: icon, name and type of the item as built, tinted with its rarity ===== -->
                <Border Grid.Row="0"
                        Padding="12,10,6,10"
                        CornerRadius="7,7,0,0"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{Binding HeaderRarity, Converter={StaticResource RarityBrush}}"
                        Background="{Binding HeaderRarity, Converter={StaticResource RarityBrush}, ConverterParameter=Tint}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="48"
                                Height="48"
                                Margin="0,0,10,0"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="{Binding HeaderRarity, Converter={StaticResource RarityBrush}}"
                                Background="{Binding HeaderRarity, Converter={StaticResource RarityBrush}, ConverterParameter=Glow}">
                            <Grid>
                                <Image Margin="4"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding HeaderIcon}" />
                                <wpf:MaterialIcon Width="22"
                                                  Height="22"
                                                  Kind="ShieldOutline"
                                                  Opacity="0.6"
                                                  Foreground="{Binding HeaderRarity, Converter={StaticResource RarityBrush}}">
                                    <!-- Placeholder while the item has no icon. -->
                                    <wpf:MaterialIcon.Style>
                                        <Style TargetType="wpf:MaterialIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HeaderIcon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </wpf:MaterialIcon.Style>
                                </wpf:MaterialIcon>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding HeaderRarity, Converter={StaticResource RarityBrush}}"
                                       Text="{Binding HeaderName}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="{Binding HeaderType}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal">
                            <Button Style="{StaticResource SubtleIconButtonStyle}"
                                    ToolTip="Open the full item builder"
                                    AutomationProperties.Name="Open the full item builder"
                                    Click="OnExpandClick">
                                <wpf:MaterialIcon Width="16" Height="16" Kind="ArrowExpand" />
                            </Button>
                            <Button Style="{StaticResource SubtleIconButtonStyle}"
                                    ToolTip="Remove this item from the bag"
                                    AutomationProperties.Name="Remove item"
                                    Command="{Binding RemoveCommand}"
                                    Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <wpf:MaterialIcon Width="16" Height="16" Kind="DeleteOutline" />
                            </Button>
                            <Button Style="{StaticResource SubtleIconButtonStyle}"
                                    ToolTip="Close (Esc)"
                                    AutomationProperties.Name="Close"
                                    Command="{Binding CancelCommand}">
                                <wpf:MaterialIcon Width="16" Height="16" Kind="Close" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Properties ===== -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- database.db missing: nothing can be listed. -->
                        <TextBlock Margin="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningForegroundBrush}"
                                   Text="{Binding EmptyListText}"
                                   Visibility="{Binding IsDatabaseAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <TextBlock Margin="12,8"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningForegroundBrush}"
                                   Text="{Binding UnknownBaseText}"
                                   Visibility="{Binding HasUnknownBaseText, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- Category: the value is the current filter; expanding shows the pills. -->
                        <Grid>
                            <ToggleButton x:Name="CategoryToggle"
                                          Style="{StaticResource InspectorExpanderStyle}"
                                          Content="Category"
                                          IsEnabled="{Binding IsDatabaseAvailable}" />
                            <TextBlock Margin="{StaticResource InspectorValueMargin}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedCategoryName}" />
                        </Grid>
                        <Border Style="{StaticResource InspectorDropDownBorderStyle}"
                                Padding="22,8,8,2"
                                Visibility="{Binding IsChecked, ElementName=CategoryToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type inventoryVm:FilterOptionViewModel}">
                                        <Button Style="{StaticResource FilterPillButtonStyle}"
                                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Click="OnCategoryPillClick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Rarity filter (gear only): the value is the current filter; expanding shows the pills. -->
                        <StackPanel Visibility="{Binding HasRarityFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <ToggleButton x:Name="RarityToggle"
                                              Style="{StaticResource InspectorExpanderStyle}"
                                              Content="Rarity"
                                              IsEnabled="{Binding IsDatabaseAvailable}" />
                                <StackPanel Margin="{StaticResource InspectorValueMargin}"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            IsHitTestVisible="False">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding SelectedRarity.DotRarity, Converter={StaticResource RarityBrush}}"
                                             Visibility="{Binding SelectedRarity.HasDot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedRarity.Name}" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource InspectorDropDownBorderStyle}"
                                    Padding="22,8,8,2"
                                    Visibility="{Binding IsChecked, ElementName=RarityToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding Rarities}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type inventoryVm:FilterOptionViewModel}">
                                            <Button Style="{StaticResource FilterPillButtonStyle}"
                                                    Command="{Binding DataContext.SelectRarityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Click="OnRarityPillClick" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- Item: the value is the selected item; expanding shows the searchable list with the search box focused. -->
                        <Grid>
                            <ToggleButton x:Name="ItemToggle"
                                          Style="{StaticResource InspectorExpanderStyle}"
                                          Content="Item"
                                          IsEnabled="{Binding IsDatabaseAvailable}"
                                          Checked="OnItemToggleChecked" />
                            <TextBlock Margin="{StaticResource InspectorValueMargin}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding SelectedOption.Rarity, Converter={StaticResource RarityBrush}, FallbackValue={StaticResource SlotLabelBrush}}"
                                       Text="{Binding SelectedItemText}" />
                        </Grid>
                        <Border Style="{StaticResource InspectorDropDownBorderStyle}"
                                Visibility="{Binding IsChecked, ElementName=ItemToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBox x:Name="ItemSearch"
                                         Margin="0,0,0,6"
                                         Padding="6,3"
                                         AutomationProperties.Name="Search items"
                                         ToolTip="Search items by name, type, set or record"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid>
                                    <ListBox x:Name="ItemList"
                                             MaxHeight="300"
                                             ItemsSource="{Binding Source={StaticResource GroupedOptions}}"
                                             SelectedItem="{Binding SelectedOption}"
                                             IsSynchronizedWithCurrentItem="False"
                                             Style="{StaticResource PlainListBoxStyle}"
                                             ItemContainerStyle="{StaticResource ListRowItemStyle}"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                             PreviewMouseLeftButtonUp="OnItemListPreviewMouseLeftButtonUp"
                                             KeyDown="OnItemListKeyDown">
                                        <ListBox.GroupStyle>
                                            <StaticResource ResourceKey="ListGroupStyle" />
                                        </ListBox.GroupStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type inventoryVm:ItemOptionViewModel}">
                                                <Grid ToolTip="{Binding RecordPath}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0"
                                                           Width="28"
                                                           Height="28"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Source="{Binding Icon}" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}"
                                                                   Text="{Binding Name}" />
                                                        <TextBlock FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   Text="{Binding Details}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Margin="8,12"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="{Binding EmptyListText}"
                                               Visibility="{Binding HasOptions, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                </Grid>
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="{Binding ListLimitText}"
                                           Visibility="{Binding HasListLimitText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <Border Padding="12,6"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Visibility="{Binding HasSizeError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ErrorForegroundBrush}"
                                       Text="{Binding SizeError}" />
                        </Border>

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- ===== Seed and stack size ===== -->
                            <HeaderedContentControl Style="{StaticResource InspectorRowStyle}" Header="Seed">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Margin="4,0,0,0"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            ToolTip="New random seed (other rolled values)"
                                            AutomationProperties.Name="Reroll seed"
                                            Command="{Binding RerollSeedCommand}">
                                        <wpf:MaterialIcon Kind="DiceMultipleOutline" Width="16" Height="16" />
                                    </Button>
                                    <TextBox Padding="4,1"
                                             AutomationProperties.Name="Seed"
                                             ToolTip="The game rolls the item's values from this number."
                                             Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </HeaderedContentControl>
                            <Border Padding="36,4,8,4"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    Visibility="{Binding HasSeedError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ErrorForegroundBrush}" Text="{Binding SeedError}" />
                            </Border>

                            <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                    Header="Stack size"
                                                    Visibility="{Binding IsStackable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox Width="100"
                                         HorizontalAlignment="Left"
                                         Padding="4,1"
                                         AutomationProperties.Name="Stack size"
                                         Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                            </HeaderedContentControl>
                            <Border Padding="36,4,8,4"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    Visibility="{Binding HasQuantityError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ErrorForegroundBrush}" Text="{Binding QuantityError}" />
                            </Border>

                            <!-- ===== Parts ===== -->
                            <StackPanel Visibility="{Binding HasParts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <ToggleButton x:Name="PartsToggle"
                                                  Style="{StaticResource InspectorExpanderStyle}"
                                                  Content="Parts"
                                                  IsChecked="True" />
                                    <TextBlock Margin="{StaticResource InspectorValueMargin}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="{Binding PartSummary}" />
                                </Grid>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=PartsToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding PartSlots}"
                                                  ItemTemplate="{StaticResource PartRowTemplate}"
                                                  Focusable="False">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Visibility" Value="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                    <TextBlock Margin="36,4,8,6"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="{Binding PartsHint}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- ===== The game's tooltip of the item as built ===== -->
                            <ToggleButton x:Name="TooltipToggle"
                                          Style="{StaticResource InspectorExpanderStyle}"
                                          Content="Game tooltip"
                                          IsEnabled="{Binding HasPreview}" />
                            <Border Padding="14,10"
                                    Background="#F2100E12"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    TextElement.Foreground="{StaticResource DollTextBrush}">
                                <Border.Visibility>
                                    <MultiBinding Converter="{StaticResource AllTrueToVisibilityConverter}">
                                        <Binding Path="IsChecked" ElementName="TooltipToggle" />
                                        <Binding Path="HasPreview" />
                                    </MultiBinding>
                                </Border.Visibility>
                                <ContentControl Focusable="False"
                                                Content="{Binding Preview}"
                                                ContentTemplate="{StaticResource ItemTooltipContentTemplate}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Footer ===== -->
                <Border Grid.Row="2"
                        Padding="10,8"
                        CornerRadius="0,0,7,7"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        Background="{DynamicResource TitleBarBackgroundBrush}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="Ctrl+Enter apply · Esc cancel" />
                        <Button DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Style="{StaticResource DialogButtonStyle}"
                                Content="Cancel"
                                Command="{Binding CancelCommand}" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="Apply"
                                Command="{Binding ApplyCommand}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

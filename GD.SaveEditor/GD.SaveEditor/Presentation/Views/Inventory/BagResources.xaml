<!--
    Look of the item grids (the bags of the inventory and the stash tabs): the game's near-black cells with thin golden
    lines, the drop preview colors and the template of an item on a grid.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:charactersVm="clr-namespace:GD.SaveEditor.Presentation.ViewModels.Characters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GD.SaveEditor;component/Presentation/Views/Characters/ItemResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Colors of the game's inventory: near-black cells with thin golden lines. -->
    <SolidColorBrush x:Key="BagFrameBrush" Color="#5A4B2C" />
    <SolidColorBrush x:Key="BagGoldBrush" Color="#D9B45A" />
    <SolidColorBrush x:Key="BagHeaderBrush" Color="#221D17" />
    <SolidColorBrush x:Key="DropValidBrush" Color="#404CE03C" />
    <SolidColorBrush x:Key="DropValidBorderBrush" Color="#4CE03C" />
    <SolidColorBrush x:Key="DropInvalidBrush" Color="#40F1707B" />
    <SolidColorBrush x:Key="DropInvalidBorderBrush" Color="#F1707B" />

    <!-- One 32 x 32 cell, tiled over the bag. -->
    <DrawingBrush x:Key="BagCellBrush"
                  TileMode="Tile"
                  Stretch="None"
                  Viewbox="0,0,32,32" ViewboxUnits="Absolute"
                  Viewport="0,0,32,32" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#0E0D0C">
                <GeometryDrawing.Pen>
                    <Pen Brush="#3D3523" Thickness="1" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,32,32" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!--
        An item in a bag: icon over a glow of its rarity, the stack size in the bottom-right corner, the game's
        tooltip. Without an icon (database or Items.arc missing) the item name is shown.
    -->
    <DataTemplate x:Key="BagItemTemplate" DataType="{x:Type charactersVm:EquipmentSlotViewModel}">
        <Border x:Name="Frame"
                Margin="1"
                BorderThickness="1"
                BorderBrush="{Binding Rarity, Converter={StaticResource RarityBrush}}"
                Background="{Binding Rarity, Converter={StaticResource RarityBrush}, ConverterParameter=Glow}"
                SnapsToDevicePixels="True"
                ToolTip="{StaticResource ItemToolTip}"
                ToolTipService.InitialShowDelay="150"
                ToolTipService.ShowDuration="60000">
            <Grid ClipToBounds="True">
                <Image Source="{Binding Icon}"
                       Stretch="Uniform"
                       StretchDirection="DownOnly"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

                <TextBlock x:Name="NameText"
                           Text="{Binding Name}"
                           Visibility="Collapsed"
                           Margin="1"
                           FontSize="8"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" />

                <TextBlock Text="{Binding QuantityText}"
                           Margin="0,0,2,0"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Foreground="White"
                           Style="{StaticResource OptionalTooltipText}">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="1" Color="Black" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasIcon}" Value="False">
                <Setter TargetName="NameText" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>

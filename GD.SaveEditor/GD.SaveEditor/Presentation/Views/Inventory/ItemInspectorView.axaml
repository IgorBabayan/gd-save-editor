<UserControl x:Class="GD.SaveEditor.Presentation.Views.Inventory.ItemInspectorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:inventoryVm="using:GD.SaveEditor.Presentation.ViewModels.Inventory"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:controls="using:GD.SaveEditor.Presentation.Controls"
             mc:Ignorable="d"
             x:DataType="inventoryVm:ItemBuilderViewModel"
             Width="460"
             Focusable="True"
             Foreground="{DynamicResource WindowForegroundBrush}">

    <!--
        Compact item builder shown next to a bag item, laid out like an object inspector (as in the Last Epoch editor):
        a name column and a value column; rows with a chevron expand into sub-properties (category and rarity pills,
        the item list, the stats of a part with its picker, the game's tooltip).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GD.SaveEditor/Presentation/Views/Characters/ItemResources.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Width of the name column; values start right after it. -->
            <GridLength x:Key="InspectorNameWidth">170</GridLength>
            <Thickness x:Key="InspectorValueMargin">178,0,6,0</Thickness>
            <Thickness x:Key="IndentLevel1">14,0,0,0</Thickness>

            <!-- Read-only (or input) row: Header in the name column, Content in the value column. Padding indents the name. -->
            <ControlTheme x:Key="InspectorRowStyle" TargetType="HeaderedContentControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border MinHeight="26"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource ControlBorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource InspectorNameWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        BorderThickness="0,0,1,0"
                                        BorderBrush="{DynamicResource ControlBorderBrush}">
                                    <Border Margin="{TemplateBinding Padding}" Padding="22,4,6,4">
                                        <ContentPresenter Name="PART_HeaderPresenter"
                                                          VerticalAlignment="Center"
                                                          Content="{TemplateBinding Header}"
                                                          ContentTemplate="{TemplateBinding HeaderTemplate}" />
                                    </Border>
                                </Border>
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Grid.Column="1"
                                                  Margin="8,3,6,3"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!--
                Expandable row: the whole row toggles, a chevron shows the state. The value is laid over the row
                (InspectorValueMargin) by the parent grid, so it can hold its own buttons.
            -->
            <ControlTheme x:Key="InspectorExpanderStyle" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd"
                                MinHeight="26"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource ControlBorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource InspectorNameWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        BorderThickness="0,0,1,0"
                                        BorderBrush="{DynamicResource ControlBorderBrush}">
                                    <DockPanel Margin="{TemplateBinding Padding}">
                                        <mi:MaterialIcon Name="Chevron"
                                                         DockPanel.Dock="Left"
                                                         Width="14"
                                                         Height="14"
                                                         Margin="4,0,0,0"
                                                         VerticalAlignment="Center"
                                                         Kind="ChevronRight"
                                                         Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                        <ContentPresenter Name="PART_ContentPresenter"
                                                          Margin="4,4,6,4"
                                                          VerticalAlignment="Center"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:checked /template/ mi|MaterialIcon#Chevron">
                    <Setter Property="Kind" Value="ChevronDown" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}" />
                </Style>
                <Style Selector="^:focus-visible /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}" />
                </Style>
                <!-- Nothing to expand (e.g. an empty part): no chevron, the label keeps its place. -->
                <Style Selector="^:disabled">
                    <Setter Property="Cursor" Value="Arrow" />
                </Style>
                <Style Selector="^:disabled /template/ mi|MaterialIcon#Chevron">
                    <Setter Property="Opacity" Value="0" />
                </Style>
            </ControlTheme>

            <!-- Panel under an expanded row (pills, item list, part picker, tooltip). -->
            <ControlTheme x:Key="InspectorDropDownBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="8" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            </ControlTheme>

            <!-- Small link button inside a value cell. -->
            <ControlTheme x:Key="InspectorLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource TextLinkButtonStyle}">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </ControlTheme>

            <!-- A category / rarity pill: rarity pills have a dot in the rarity's color. -->
            <ControlTheme x:Key="FilterPillButtonStyle" TargetType="Button" x:DataType="inventoryVm:FilterOptionViewModel">
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd"
                                Classes.selected="{Binding IsSelected}"
                                Padding="10,4"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource ControlBackgroundBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding DotRarity, Converter={StaticResource RarityBrush}}"
                                         IsVisible="{Binding HasDot}" />
                                <TextBlock Name="Text"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource WindowForegroundBrush}"
                                           Text="{Binding Name}" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                </Style>
                <!-- Declared last so the selected look wins over hover. -->
                <Style Selector="^ /template/ Border#Bd.selected">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                </Style>
                <Style Selector="^ /template/ Border#Bd.selected TextBlock#Text">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </ControlTheme>

            <!-- Group header of the item and part lists (see ListGroupHeader). -->
            <DataTemplate x:Key="ListGroupHeaderTemplate" DataType="inventoryVm:ListGroupHeader">
                <TextBlock Margin="8,8,8,2"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="{Binding Name}" />
            </DataTemplate>

            <!-- Picker shown under the part being filled (DataContext: ItemPartSlotViewModel). -->
            <DataTemplate x:Key="PartPickerTemplate" DataType="inventoryVm:ItemPartSlotViewModel">
                <Border Theme="{StaticResource InspectorDropDownBorderStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Theme="{StaticResource InspectorLinkButtonStyle}"
                                    Content="Cancel"
                                    Command="{Binding $parent[UserControl].((inventoryVm:ItemBuilderViewModel)DataContext).ClosePickerCommand}" />
                            <TextBox Classes="pickerSearch"
                                     Padding="6,3"
                                     AutomationProperties.Name="Search parts"
                                     ToolTip.Tip="Search by name, stat or record"
                                     Text="{Binding $parent[UserControl].((inventoryVm:ItemBuilderViewModel)DataContext).PickerSearchText}" />
                        </DockPanel>
                        <Panel>
                            <controls:GroupedListBox
                                     MaxHeight="260"
                                     ItemsSource="{Binding $parent[UserControl].((inventoryVm:ItemBuilderViewModel)DataContext).PickerOptionRows}"
                                     SelectedItem="{Binding $parent[UserControl].((inventoryVm:ItemBuilderViewModel)DataContext).SelectedPickerOption}"
                                     Theme="{StaticResource PlainListBoxStyle}"
                                     ItemContainerTheme="{StaticResource ListRowItemStyle}">
                                <controls:GroupedListBox.DataTemplates>
                                    <StaticResource ResourceKey="ListGroupHeaderTemplate" />
                                    <DataTemplate DataType="inventoryVm:PartOptionViewModel">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}"
                                                           Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           FontSize="11"
                                                           Theme="{StaticResource SecondaryTextStyle}"
                                                           Text="{Binding Details}" />
                                            </Grid>
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Theme="{StaticResource SecondaryTextStyle}"
                                                       Text="{Binding Summary}"
                                                       IsVisible="{Binding HasSummary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:GroupedListBox.DataTemplates>
                            </controls:GroupedListBox>
                            <TextBlock Margin="8,12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Theme="{StaticResource SecondaryTextStyle}"
                                       Text="Nothing matches the search."
                                       IsVisible="{Binding !$parent[UserControl].((inventoryVm:ItemBuilderViewModel)DataContext).HasPickerOptions}" />
                        </Panel>
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Theme="{StaticResource SecondaryTextStyle}"
                                   Text="{Binding $parent[UserControl].((inventoryVm:ItemBuilderViewModel)DataContext).PickerLimitText}"
                                   IsVisible="{Binding $parent[UserControl].((inventoryVm:ItemBuilderViewModel)DataContext).HasPickerLimitText}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- One part: label + its name (or "Add prefix"); expands into its stats. -->
            <DataTemplate x:Key="PartRowTemplate" DataType="inventoryVm:ItemPartSlotViewModel">
                <StackPanel IsVisible="{Binding IsAvailable}">
                    <Panel>
                        <ToggleButton x:Name="Toggle"
                                      Theme="{StaticResource InspectorExpanderStyle}"
                                      Padding="{StaticResource IndentLevel1}"
                                      IsChecked="True"
                                      IsEnabled="{Binding HasSummary}">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                        </ToggleButton>

                        <!-- Value: the part's name with Change / Remove, or "Add …" for an empty slot. -->
                        <DockPanel Margin="{StaticResource InspectorValueMargin}" LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Theme="{StaticResource InspectorLinkButtonStyle}"
                                    Content="Remove"
                                    Command="{Binding RemoveCommand}"
                                    IsVisible="{Binding HasPart}" />
                            <Button DockPanel.Dock="Right"
                                    Theme="{StaticResource InspectorLinkButtonStyle}"
                                    Content="Change"
                                    Command="{Binding ChooseCommand}"
                                    IsVisible="{Binding HasPart}" />
                            <Button HorizontalAlignment="Left"
                                    Margin="-6,0,0,0"
                                    Theme="{StaticResource InspectorLinkButtonStyle}"
                                    Content="{Binding AddText}"
                                    Command="{Binding ChooseCommand}"
                                    IsVisible="{Binding !HasPart}" />
                            <TextBlock VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}"
                                       Text="{Binding Name}"
                                       IsVisible="{Binding HasPart}" />
                        </DockPanel>
                    </Panel>

                    <!-- Sub-property: the stats of the part on one line. -->
                    <Border Padding="50,4,8,4"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlBorderBrush}">
                        <Border.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="#Toggle.IsChecked" />
                                <Binding Path="HasSummary" />
                            </MultiBinding>
                        </Border.IsVisible>
                        <TextBlock FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TooltipStatBrush}"
                                   Text="{Binding Summary}" />
                    </Border>

                    <!-- The picker exists only for the part being filled (one list, one selection binding). -->
                    <ContentControl Classes="partPicker"
                                    Classes.picking="{Binding IsPicking}"
                                    Focusable="False"
                                    ContentTemplate="{StaticResource PartPickerTemplate}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ContentControl.partPicker.picking" x:DataType="inventoryVm:ItemPartSlotViewModel">
            <Setter Property="Content" Value="{Binding}" />
        </Style>
    </UserControl.Styles>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ApplyCommand}" />
    </UserControl.KeyBindings>

    <!-- The shadow is a box shadow of the frame: no effect layer, the text stays crisp. -->
    <Border CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{Binding HeaderRarity, Converter={StaticResource RarityBrush}}"
            Background="{DynamicResource WindowBackgroundBrush}"
            BoxShadow="0 3 18 0 #73000000">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- ===== Header: icon, name and type of the item as built, tinted with its rarity ===== -->
            <Border Grid.Row="0"
                    Padding="12,10,6,10"
                    CornerRadius="7,7,0,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{Binding HeaderRarity, Converter={StaticResource RarityBrush}}"
                    Background="{Binding HeaderRarity, Converter={StaticResource RarityBrush}, ConverterParameter=Tint}">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            Margin="0,0,10,0"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="{Binding HeaderRarity, Converter={StaticResource RarityBrush}}"
                            Background="{Binding HeaderRarity, Converter={StaticResource RarityBrush}, ConverterParameter=Glow}">
                        <Panel>
                            <Image Margin="4"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                   Source="{Binding HeaderIcon}" />
                            <!-- Placeholder while the item has no icon. -->
                            <mi:MaterialIcon Width="22"
                                             Height="22"
                                             Kind="ShieldOutline"
                                             Opacity="0.6"
                                             Foreground="{Binding HeaderRarity, Converter={StaticResource RarityBrush}}"
                                             IsVisible="{Binding HeaderIcon, Converter={x:Static ObjectConverters.IsNull}}" />
                        </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding HeaderRarity, Converter={StaticResource RarityBrush}}"
                                   Text="{Binding HeaderName}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Theme="{StaticResource SecondaryTextStyle}"
                                   Text="{Binding HeaderType}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal">
                        <Button Theme="{StaticResource SubtleIconButtonStyle}"
                                ToolTip.Tip="Open the full item builder"
                                AutomationProperties.Name="Open the full item builder"
                                Click="OnExpandClick">
                            <mi:MaterialIcon Width="16" Height="16" Kind="ArrowExpand" />
                        </Button>
                        <Button Theme="{StaticResource SubtleIconButtonStyle}"
                                ToolTip.Tip="Remove this item from the character"
                                AutomationProperties.Name="Remove item"
                                Command="{Binding RemoveCommand}"
                                IsVisible="{Binding CanRemove}">
                            <mi:MaterialIcon Width="16" Height="16" Kind="DeleteOutline" />
                        </Button>
                        <Button Theme="{StaticResource SubtleIconButtonStyle}"
                                ToolTip.Tip="Close (Esc)"
                                AutomationProperties.Name="Close"
                                Command="{Binding CancelCommand}">
                            <mi:MaterialIcon Width="16" Height="16" Kind="Close" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Properties ===== -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- database.db missing: nothing can be listed. -->
                    <TextBlock Margin="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningForegroundBrush}"
                               Text="{Binding EmptyListText}"
                               IsVisible="{Binding !IsDatabaseAvailable}" />
                    <TextBlock Margin="12,8"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningForegroundBrush}"
                               Text="{Binding UnknownBaseText}"
                               IsVisible="{Binding HasUnknownBaseText}" />

                    <!-- Category: the value is the current filter; expanding shows the pills. A kind picked in the
                         bag's "Build a new item" menu fixes it: the row shows that kind instead. -->
                    <HeaderedContentControl Theme="{StaticResource InspectorRowStyle}"
                                            Header="Type"
                                            IsVisible="{Binding !HasCategoryFilter}">
                        <TextBlock FontWeight="SemiBold" Text="{Binding KindName}" />
                    </HeaderedContentControl>
                    <Panel IsVisible="{Binding HasCategoryFilter}">
                        <ToggleButton x:Name="CategoryToggle"
                                      Theme="{StaticResource InspectorExpanderStyle}"
                                      Content="Category"
                                      IsEnabled="{Binding IsDatabaseAvailable}" />
                        <TextBlock Margin="{StaticResource InspectorValueMargin}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedCategoryName}" />
                    </Panel>
                    <Border Theme="{StaticResource InspectorDropDownBorderStyle}"
                            Padding="22,8,8,2"
                            IsVisible="{Binding #CategoryToggle.IsChecked}">
                        <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="inventoryVm:FilterOptionViewModel">
                                    <Button Classes="categoryPill"
                                            Theme="{StaticResource FilterPillButtonStyle}"
                                            Command="{Binding $parent[UserControl].((inventoryVm:ItemBuilderViewModel)DataContext).SelectCategoryCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Rarity filter (gear only): the value is the current filter; expanding shows the pills. -->
                    <StackPanel IsVisible="{Binding HasRarityFilter}">
                        <Panel>
                            <ToggleButton x:Name="RarityToggle"
                                          Theme="{StaticResource InspectorExpanderStyle}"
                                          Content="Rarity"
                                          IsEnabled="{Binding IsDatabaseAvailable}" />
                            <StackPanel Margin="{StaticResource InspectorValueMargin}"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        IsHitTestVisible="False">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding SelectedRarity.DotRarity, Converter={StaticResource RarityBrush}}"
                                         IsVisible="{Binding SelectedRarity.HasDot}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedRarity.Name}" />
                            </StackPanel>
                        </Panel>
                        <Border Theme="{StaticResource InspectorDropDownBorderStyle}"
                                Padding="22,8,8,2"
                                IsVisible="{Binding #RarityToggle.IsChecked}">
                            <ItemsControl ItemsSource="{Binding Rarities}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="inventoryVm:FilterOptionViewModel">
                                        <Button Classes="rarityPill"
                                                Theme="{StaticResource FilterPillButtonStyle}"
                                                Command="{Binding $parent[UserControl].((inventoryVm:ItemBuilderViewModel)DataContext).SelectRarityCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- Item: the value is the selected item; expanding shows the searchable list with the search box focused. -->
                    <Panel>
                        <ToggleButton x:Name="ItemToggle"
                                      Theme="{StaticResource InspectorExpanderStyle}"
                                      Content="Item"
                                      IsEnabled="{Binding IsDatabaseAvailable}"
                                      IsCheckedChanged="OnItemToggleChanged" />
                        <TextBlock Margin="{StaticResource InspectorValueMargin}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding SelectedOption.Rarity, Converter={StaticResource RarityBrush}, FallbackValue={StaticResource SlotLabelBrush}}"
                                   Text="{Binding SelectedItemText}" />
                    </Panel>
                    <Border Theme="{StaticResource InspectorDropDownBorderStyle}"
                            IsVisible="{Binding #ItemToggle.IsChecked}">
                        <StackPanel>
                            <TextBox x:Name="ItemSearch"
                                     Margin="0,0,0,6"
                                     Padding="6,3"
                                     AutomationProperties.Name="Search items"
                                     ToolTip.Tip="Search items by name, type, set or record"
                                     Text="{Binding SearchText}" />
                            <Panel>
                                <controls:GroupedListBox x:Name="ItemList"
                                         MaxHeight="300"
                                         ItemsSource="{Binding OptionRows}"
                                         SelectedItem="{Binding SelectedOption}"
                                         Theme="{StaticResource PlainListBoxStyle}"
                                         ItemContainerTheme="{StaticResource ListRowItemStyle}"
                                         KeyDown="OnItemListKeyDown">
                                    <controls:GroupedListBox.DataTemplates>
                                        <StaticResource ResourceKey="ListGroupHeaderTemplate" />
                                        <DataTemplate DataType="inventoryVm:ItemOptionViewModel">
                                            <Grid ColumnDefinitions="32,*,Auto" ToolTip.Tip="{Binding RecordPath}">
                                                <Image Grid.Column="0"
                                                       Width="28"
                                                       Height="28"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                       Source="{Binding Icon}" />
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}"
                                                               Text="{Binding Name}" />
                                                    <TextBlock FontSize="10"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               Text="{Binding Details}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </controls:GroupedListBox.DataTemplates>
                                </controls:GroupedListBox>
                                <TextBlock Margin="8,12"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Theme="{StaticResource SecondaryTextStyle}"
                                           Text="{Binding EmptyListText}"
                                           IsVisible="{Binding !HasOptions}" />
                            </Panel>
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Theme="{StaticResource SecondaryTextStyle}"
                                       Text="{Binding ListLimitText}"
                                       IsVisible="{Binding HasListLimitText}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="12,6"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            IsVisible="{Binding HasSizeError}">
                        <TextBlock FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ErrorForegroundBrush}"
                                   Text="{Binding SizeError}" />
                    </Border>

                    <StackPanel IsVisible="{Binding HasSelection}">
                        <!-- ===== Seed and stack size ===== -->
                        <HeaderedContentControl Theme="{StaticResource InspectorRowStyle}" Header="Seed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Margin="4,0,0,0"
                                        Theme="{StaticResource SubtleIconButtonStyle}"
                                        ToolTip.Tip="New random seed (other rolled values)"
                                        AutomationProperties.Name="Reroll seed"
                                        Command="{Binding RerollSeedCommand}">
                                    <mi:MaterialIcon Kind="DiceMultipleOutline" Width="16" Height="16" />
                                </Button>
                                <TextBox Padding="4,1"
                                         MinHeight="24"
                                         AutomationProperties.Name="Seed"
                                         ToolTip.Tip="The game rolls the item's values from this number."
                                         Text="{Binding SeedText}" />
                            </DockPanel>
                        </HeaderedContentControl>
                        <Border Padding="36,4,8,4"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                IsVisible="{Binding HasSeedError}">
                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ErrorForegroundBrush}" Text="{Binding SeedError}" />
                        </Border>

                        <HeaderedContentControl Theme="{StaticResource InspectorRowStyle}"
                                                Header="Stack size"
                                                IsVisible="{Binding IsStackable}">
                            <TextBox Width="100"
                                     MinHeight="24"
                                     HorizontalAlignment="Left"
                                     Padding="4,1"
                                     AutomationProperties.Name="Stack size"
                                     Text="{Binding QuantityText}" />
                        </HeaderedContentControl>
                        <Border Padding="36,4,8,4"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                IsVisible="{Binding HasQuantityError}">
                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ErrorForegroundBrush}" Text="{Binding QuantityError}" />
                        </Border>

                        <!-- ===== Parts ===== -->
                        <StackPanel IsVisible="{Binding HasParts}">
                            <Panel>
                                <ToggleButton x:Name="PartsToggle"
                                              Theme="{StaticResource InspectorExpanderStyle}"
                                              Content="Parts"
                                              IsChecked="True" />
                                <TextBlock Margin="{StaticResource InspectorValueMargin}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Theme="{StaticResource SecondaryTextStyle}"
                                           Text="{Binding PartSummary}" />
                            </Panel>
                            <StackPanel IsVisible="{Binding #PartsToggle.IsChecked}">
                                <ItemsControl ItemsSource="{Binding PartSlots}"
                                              ItemTemplate="{StaticResource PartRowTemplate}"
                                              Focusable="False" />
                                <TextBlock Margin="36,4,8,6"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Theme="{StaticResource SecondaryTextStyle}"
                                           Text="{Binding PartsHint}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ===== The game's tooltip of the item as built ===== -->
                        <ToggleButton x:Name="TooltipToggle"
                                      Theme="{StaticResource InspectorExpanderStyle}"
                                      Content="Game tooltip"
                                      IsEnabled="{Binding HasPreview}" />
                        <Border Padding="14,10"
                                Background="#F2100E12"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                TextElement.Foreground="{StaticResource DollTextBrush}">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="#TooltipToggle.IsChecked" />
                                    <Binding Path="HasPreview" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <ContentControl Focusable="False"
                                            Content="{Binding Preview}"
                                            ContentTemplate="{StaticResource ItemTooltipContentTemplate}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Footer ===== -->
            <Border Grid.Row="2"
                    Padding="10,8"
                    CornerRadius="0,0,7,7"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    Background="{DynamicResource TitleBarBackgroundBrush}">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Theme="{StaticResource SecondaryTextStyle}"
                               Text="Ctrl+Enter apply · Esc cancel" />
                    <Button DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Theme="{StaticResource DialogButtonStyle}"
                            Content="Cancel"
                            Command="{Binding CancelCommand}" />
                    <Button DockPanel.Dock="Right"
                            Theme="{StaticResource AccentButtonStyle}"
                            Content="Apply"
                            Command="{Binding ApplyCommand}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

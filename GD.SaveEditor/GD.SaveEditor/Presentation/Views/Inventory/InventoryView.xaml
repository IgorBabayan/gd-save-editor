<UserControl x:Class="GD.SaveEditor.Presentation.Views.Inventory.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:inventoryVm="clr-namespace:GD.SaveEditor.Presentation.ViewModels.Inventory"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=inventoryVm:InventoryViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="700" d:DesignWidth="900">

    <!-- Placeholder until the inventory editor is implemented. -->
    <Border Margin="0,16,0,0" Style="{StaticResource InventorySectionBorderStyle}">
        <TextBlock Style="{StaticResource EmptyPageTextStyle}" Text="The inventory editor is not available yet." />
    </Border>
</UserControl>

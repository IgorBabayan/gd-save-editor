<UserControl x:Class="GD.SaveEditor.Presentation.Views.Factions.FactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:factionsVm="clr-namespace:GD.SaveEditor.Presentation.ViewModels.Factions"
             xmlns:behaviors="clr-namespace:GD.SaveEditor.Presentation.Behaviors"
             xmlns:wpf="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=factionsVm:FactionsViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <Style x:Key="NoteTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
        </Style>

        <Style x:Key="ValueTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            One faction: name, rank (click to pick another; the menu is built in code-behind with the themed menu
            style), undo, value. Changed values are in the accent color, invalid ones get a red frame.
        -->
        <DataTemplate x:Key="FactionTemplate" DataType="{x:Type factionsVm:FactionItemViewModel}">
            <Grid Margin="0,3,16,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ToolTip}">
                    <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <wpf:MaterialIcon Kind="LockOutline" Width="12" Height="12" Margin="6,0,0,0"
                                      Foreground="{DynamicResource SecondaryForegroundBrush}"
                                      ToolTip="Not met yet: changing the reputation unlocks it"
                                      Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <Button x:Name="TierButton"
                        Grid.Column="1"
                        Margin="8,0,4,0"
                        Padding="0"
                        MinWidth="0"
                        MinHeight="0"
                        Style="{StaticResource SubtleIconButtonStyle}"
                        IsEnabled="{Binding CanEdit}"
                        Click="OnTierButtonClick"
                        ToolTip="Set the reputation to a rank"
                        AutomationProperties.Name="{Binding Name, StringFormat='Rank of {0}'}">
                    <Border x:Name="TierBadge"
                            Style="{StaticResource BadgeBorderStyle}"
                            BorderBrush="{DynamicResource ControlBorderBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TierText" Text="{Binding TierName}" FontSize="11"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" />
                            <wpf:MaterialIcon Kind="ChevronDown" Width="12" Height="12" Margin="2,0,0,0"
                                              Foreground="{DynamicResource SecondaryForegroundBrush}" />
                        </StackPanel>
                    </Border>
                </Button>

                <Button Grid.Column="2"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtleIconButtonStyle}"
                        ToolTip="Undo the change (Esc)"
                        AutomationProperties.Name="{Binding Name, StringFormat='Undo {0}'}"
                        Command="{Binding ResetCommand}"
                        Visibility="{Binding IsChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <wpf:MaterialIcon Kind="Undo" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" />
                </Button>

                <TextBox x:Name="Box"
                         Grid.Column="3"
                         AutomationProperties.Name="{Binding Name, StringFormat='Reputation with {0}'}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsReadOnly, Mode=OneWay}"
                         ToolTip="{Binding ToolTip}"
                         Style="{StaticResource ValueTextBoxStyle}"
                         behaviors:NumericInput.IsEnabled="True"
                         behaviors:NumericInput.Minimum="{Binding Minimum}"
                         behaviors:NumericInput.Maximum="{Binding Maximum}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Escape" Command="{Binding ResetCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHostileNow}" Value="True">
                    <Setter TargetName="TierText" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                    <Setter TargetName="TierBadge" Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Box" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
                    <Setter TargetName="Box" Property="ToolTip" Value="{Binding Error}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Allies or enemies: title, count at the top rank, buttons, then the factions in two columns. -->
        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type factionsVm:FactionGroupViewModel}">
            <Border Margin="0,12,0,0"
                    Padding="16,12"
                    MinHeight="0"
                    Style="{StaticResource InventorySectionBorderStyle}"
                    Visibility="{Binding HasFactions, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Text="{Binding Title}"
                                   Style="{StaticResource SectionHeaderTextStyle}" />
                        <Border DockPanel.Dock="Left"
                                Margin="10,0,0,0"
                                Style="{StaticResource BadgeBorderStyle}"
                                BorderBrush="{DynamicResource ControlBorderBrush}">
                            <TextBlock Text="{Binding CountText}" FontSize="11"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" />
                        </Border>
                        <Button DockPanel.Dock="Right"
                                MinWidth="0"
                                MinHeight="26"
                                Padding="10,2"
                                Style="{StaticResource DialogButtonStyle}"
                                Command="{Binding SetAllToNeutralCommand}"
                                ToolTip="Set every faction of this group to Tolerated (0)">
                            <TextBlock Text="All Tolerated" FontSize="12" VerticalAlignment="Center" />
                        </Button>
                        <Button DockPanel.Dock="Right"
                                Margin="0,0,8,0"
                                MinWidth="0"
                                MinHeight="26"
                                Padding="10,2"
                                Style="{StaticResource DialogButtonStyle}"
                                Command="{Binding SetAllToMaxCommand}"
                                ToolTip="{Binding MaxTierName, StringFormat='Set every faction of this group to {0}'}">
                            <TextBlock Text="{Binding MaxTierName, StringFormat='All {0}'}" FontSize="12" VerticalAlignment="Center" />
                        </Button>
                    </DockPanel>

                    <ItemsControl Margin="0,10,0,0"
                                  ItemsSource="{Binding Factions}"
                                  ItemTemplate="{StaticResource FactionTemplate}"
                                  Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,16,0,16">
            <!-- ===== Totals and the buttons for every faction ===== -->
            <Border Padding="16,12" MinHeight="0" Style="{StaticResource InventorySectionBorderStyle}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Text="Factions"
                                   Style="{StaticResource SectionHeaderTextStyle}" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource SubtleIconButtonStyle}"
                                ToolTip="Undo all faction changes"
                                AutomationProperties.Name="Undo faction changes"
                                Command="{Binding ResetAllCommand}"
                                Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <wpf:MaterialIcon Kind="Undo" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="Undo all" Margin="4,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding SummaryText}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{Binding HasFactions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource SecondaryTextStyle}"
                               FontSize="11"
                               Text="Negative values are infamy. Ranks: Tolerated 0, Friendly 1,500, Respected 5,000, Honored 10,000, Revered 25,000; infamy: Hostile, Despised 1,500, Hated 8,000, Nemesis 20,000." />

                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding MaxAllCommand}"
                                Content="Allies Revered, enemies Nemesis"
                                ToolTip="Every ally to Revered (25,000) and every enemy to Nemesis (-20,000)" />
                    </WrapPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource NoteTextStyle}"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <ContentControl Content="{Binding Allies}" ContentTemplate="{StaticResource GroupTemplate}" Focusable="False" />
            <ContentControl Content="{Binding Enemies}" ContentTemplate="{StaticResource GroupTemplate}" Focusable="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

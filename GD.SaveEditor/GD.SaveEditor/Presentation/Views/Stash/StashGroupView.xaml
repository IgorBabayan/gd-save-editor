<inventoryViews:ItemGridView x:Class="GD.SaveEditor.Presentation.Views.Stash.StashGroupView"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             xmlns:inventoryVm="clr-namespace:GD.SaveEditor.Presentation.ViewModels.Inventory"
                             xmlns:charactersVm="clr-namespace:GD.SaveEditor.Presentation.ViewModels.Characters"
                             xmlns:stashVm="clr-namespace:GD.SaveEditor.Presentation.ViewModels.Stash"
                             xmlns:inventoryViews="clr-namespace:GD.SaveEditor.Presentation.Views.Inventory"
                             xmlns:wpf="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
                             mc:Ignorable="d"
                             d:DataContext="{d:DesignInstance Type=stashVm:StashGroupViewModel, IsDesignTimeCreatable=False}"
                             d:DesignHeight="700" d:DesignWidth="400">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GD.SaveEditor;component/Presentation/Views/Inventory/BagResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                A bag: the cell grid with its items placed on it by cell. Items are dragged by the mouse; while one is
                over the bag, the cells it would cover are shown green (it fits) or red (outside the bag or over
                another item). A click on an item opens the item inspector next to it; a right-click on a free cell
                offers to build a new item of a kind there, on an item to change or remove it.
            -->
            <DataTemplate x:Key="BagGridTemplate" DataType="{x:Type inventoryVm:InventoryBagViewModel}">
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BorderThickness="1"
                        BorderBrush="{StaticResource BagFrameBrush}"
                        SnapsToDevicePixels="True">
                    <Grid Width="{Binding PixelWidth}"
                          Height="{Binding PixelHeight}"
                          Background="{StaticResource BagCellBrush}"
                          AllowDrop="True"
                          DragOver="OnBagDragOver"
                          DragLeave="OnBagDragLeave"
                          Drop="OnBagDrop"
                          MouseRightButtonUp="OnBagMouseRightButtonUp">
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type inventoryVm:InventoryItemViewModel}">
                                    <ContentControl x:Name="ItemHost"
                                                    Width="{Binding Width}"
                                                    Height="{Binding Height}"
                                                    Focusable="False"
                                                    Content="{Binding Item}"
                                                    ContentTemplate="{StaticResource BagItemTemplate}"
                                                    PreviewMouseLeftButtonDown="OnItemMouseDown"
                                                    PreviewMouseLeftButtonUp="OnItemMouseUp"
                                                    PreviewMouseMove="OnItemMouseMove" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSizeKnown}" Value="True">
                                            <Setter TargetName="ItemHost" Property="Cursor" Value="Hand" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                            <Setter TargetName="ItemHost" Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Drop preview: the cells the dragged item would cover. -->
                        <Canvas IsHitTestVisible="False">
                            <Border Canvas.Left="{Binding PreviewLeft}"
                                    Canvas.Top="{Binding PreviewTop}"
                                    Width="{Binding PreviewWidth}"
                                    Height="{Binding PreviewHeight}"
                                    BorderThickness="1"
                                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource DropInvalidBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DropInvalidBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreviewValid}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource DropValidBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DropValidBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Canvas>

                        <TextBlock Text="Empty"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource SlotLabelBrush}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!--
                Tab buttons of the stash: a chest icon with the tab number, gold when shown. A tab that was not bought
                in the game yet is in the save file neither: its button is disabled and shows a lock.
            -->
            <Style x:Key="StashTabItemStyle" TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ToolTip" Value="{Binding Summary}" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                <!-- Holding a dragged item over a tab shows that tab; dropping it there puts it in the first free cell. -->
                <Setter Property="AllowDrop" Value="True" />
                <EventSetter Event="DragEnter" Handler="OnBagTabDragEnter" />
                <EventSetter Event="DragOver" Handler="OnBagTabDragOver" />
                <EventSetter Event="Drop" Handler="OnBagTabDrop" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd"
                                    Width="34" Height="30"
                                    Margin="3,0,0,0"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource SlotBorderBrush}"
                                    Background="{StaticResource SlotBackgroundBrush}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <wpf:MaterialIcon x:Name="TabIcon"
                                                      Kind="PackageVariant"
                                                      Width="18" Height="18"
                                                      Foreground="{StaticResource DollSecondaryTextBrush}" />
                                    <TextBlock x:Name="NumberText"
                                               Text="{Binding Number}"
                                               Margin="0,0,3,1"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Foreground="{StaticResource DollTextBrush}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                    <Setter TargetName="TabIcon" Property="Kind" Value="PackageVariantClosed" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BagFrameBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BagGoldBrush}" />
                                    <Setter TargetName="TabIcon" Property="Foreground" Value="{StaticResource BagGoldBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                    <Setter TargetName="TabIcon" Property="Kind" Value="LockOutline" />
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                    <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                                    <Setter Property="Cursor" Value="No" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- One stash, like the game's stash window: the tab buttons, then the grid of the selected tab. -->
    <Border Margin="0,0,16,16"
            Padding="14"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            Background="{StaticResource DollBackgroundBrush}">
        <StackPanel>
            <Border Height="38"
                    Margin="0,0,0,6"
                    Padding="8,0,4,0"
                    CornerRadius="3"
                    Background="{StaticResource BagHeaderBrush}">
                <DockPanel LastChildFill="False" VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource DollTextBrush}" />

                    <!-- Makes a new item in the item builder and puts it at the first free cell of the shown tab. -->
                    <Button DockPanel.Dock="Left"
                            Margin="8,0,0,0"
                            Style="{StaticResource SubtleIconButtonStyle}"
                            ToolTip="Add an item to the shown tab (right-click a cell to put it there)"
                            AutomationProperties.Name="Add item"
                            Command="{Binding NewItemCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Visibility="{Binding CanEditItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <wpf:MaterialIcon Kind="PlusBoxOutline" Width="18" Height="18" Foreground="{StaticResource BagGoldBrush}" />
                    </Button>

                    <!-- Puts the tabs back as the file has them (shown while something in them changed). -->
                    <Button DockPanel.Dock="Left"
                            Margin="4,0,0,0"
                            Style="{StaticResource SubtleIconButtonStyle}"
                            ToolTip="Undo all changes to this stash (moved, added, changed and removed items)"
                            AutomationProperties.Name="Undo stash changes"
                            Command="{Binding ResetItemsCommand}"
                            Visibility="{Binding AreItemsChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <wpf:MaterialIcon Kind="Undo" Width="16" Height="16" Foreground="{StaticResource BagGoldBrush}" />
                    </Button>
                </DockPanel>
            </Border>

            <ListBox Margin="0,0,0,6"
                     HorizontalAlignment="Left"
                     ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource StashTabItemStyle}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Stash tabs"
                     Visibility="{Binding HasTabs, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <TextBlock Margin="0,0,0,6"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Text="{Binding SelectedTab.Name}"
                       Foreground="{StaticResource DollSecondaryTextBrush}"
                       Visibility="{Binding HasTabs, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ContentControl Focusable="False"
                            HorizontalAlignment="Left"
                            Content="{Binding SelectedTab}"
                            ContentTemplate="{StaticResource BagGridTemplate}" />

            <TextBlock Margin="0,8,0,0"
                       MaxWidth="340"
                       HorizontalAlignment="Left"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="{Binding Notice}"
                       Foreground="{StaticResource DollSecondaryTextBrush}"
                       Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Margin="0,8,0,0"
                       MaxWidth="340"
                       HorizontalAlignment="Left"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource WarningForegroundBrush}"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Margin="0,8,0,0"
                       MaxWidth="340"
                       HorizontalAlignment="Left"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="{Binding MoveHint}"
                       Foreground="{DynamicResource WarningForegroundBrush}"
                       Visibility="{Binding HasMoveHint, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Margin="0,8,0,0"
                       FontSize="11"
                       Text="Reading item names and icons…"
                       Foreground="{StaticResource DollSecondaryTextBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </Border>
</inventoryViews:ItemGridView>

<UserControl x:Class="GD.SaveEditor.Presentation.Views.Stash.MaterialStorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:stashVm="clr-namespace:GD.SaveEditor.Presentation.ViewModels.Stash"
             xmlns:behaviors="clr-namespace:GD.SaveEditor.Presentation.Behaviors"
             xmlns:wpf="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=stashVm:MaterialStorageViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="700" d:DesignWidth="520">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GD.SaveEditor;component/Presentation/Views/Inventory/BagResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Amount field under a material: black box with the number right-aligned, gold once changed. -->
            <Style x:Key="AmountTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="20" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource DollTextBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource DollTextBrush}" />
                <Setter Property="SelectionBrush" Value="{StaticResource BagGoldBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BagFrameBrush}" />
                <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    CornerRadius="2"
                                    Padding="3,0"
                                    BorderThickness="1"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Background="#050505"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BagGoldBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BagGoldBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource DollSecondaryTextBrush}" />
                        <Setter Property="Cursor" Value="Arrow" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                One material like on the Smuggler's pages: its icon with the game's tooltip, the amount under it. A
                material with nothing stored is drawn faded, as the game does.
            -->
            <DataTemplate x:Key="MaterialTemplate" DataType="{x:Type stashVm:MaterialViewModel}">
                <Border x:Name="Tile"
                        Width="60"
                        Margin="2"
                        Padding="3"
                        CornerRadius="3"
                        BorderThickness="1"
                        BorderBrush="{StaticResource SlotBorderBrush}"
                        Background="{StaticResource SlotBackgroundBrush}"
                        SnapsToDevicePixels="True"
                        Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid x:Name="IconHost"
                              Height="40"
                              Background="Transparent"
                              DataContext="{Binding Item}"
                              ToolTip="{StaticResource ItemToolTip}"
                              ToolTipService.InitialShowDelay="150"
                              ToolTipService.ShowDuration="60000">
                            <Image Source="{Binding Icon}"
                                   Stretch="Uniform"
                                   StretchDirection="DownOnly"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                            <TextBlock x:Name="NameText"
                                       Text="{Binding Name}"
                                       Visibility="Collapsed"
                                       FontSize="8"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource DollSecondaryTextBrush}" />
                        </Grid>
                        <TextBox Margin="0,3,0,0"
                                 Style="{StaticResource AmountTextBoxStyle}"
                                 Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnly, Mode=OneWay}"
                                 AutomationProperties.Name="{Binding Item.Name}"
                                 behaviors:NumericInput.IsEnabled="True"
                                 behaviors:NumericInput.Maximum="999999" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Item.HasIcon}" Value="False">
                        <Setter TargetName="NameText" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OriginalAmount}" Value="0">
                        <Setter TargetName="IconHost" Property="Opacity" Value="0.45" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                        <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource BagGoldBrush}" />
                        <Setter TargetName="IconHost" Property="Opacity" Value="1" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="MaterialPanel">
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The Smuggler's material storage: its Components and Crafting materials pages, an amount per material. -->
    <Border Width="440"
            Margin="0,0,16,16"
            Padding="14"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            Background="{StaticResource DollBackgroundBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Height="38"
                    Margin="0,0,0,6"
                    Padding="8,0,4,0"
                    CornerRadius="3"
                    Background="{StaticResource BagHeaderBrush}">
                <DockPanel LastChildFill="False" VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource DollTextBrush}" />

                    <!-- Puts every amount of the file back (shown while something changed). -->
                    <Button DockPanel.Dock="Left"
                            Margin="8,0,0,0"
                            Style="{StaticResource SubtleIconButtonStyle}"
                            ToolTip="Undo all changes to the material storage"
                            AutomationProperties.Name="Undo material changes"
                            Command="{Binding ResetCommand}"
                            Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <wpf:MaterialIcon Kind="Undo" Width="16" Height="16" Foreground="{StaticResource BagGoldBrush}" />
                    </Button>

                    <!-- Search like the Smuggler's: by name (or record path). -->
                    <Grid DockPanel.Dock="Right" Width="150" VerticalAlignment="Center">
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="22,0,4,0"
                                 AutomationProperties.Name="Search materials"
                                 ToolTip="Show only materials whose name contains this text" />
                        <wpf:MaterialIcon Kind="Magnify"
                                          Width="14" Height="14"
                                          Margin="6,0,0,0"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          Foreground="{StaticResource DollSecondaryTextBrush}" />
                    </Grid>
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Margin="0,8,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="{Binding Notice}"
                           Foreground="{StaticResource DollSecondaryTextBrush}" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="Only the stored materials are listed, without icons: generate the game database (database button in the title bar) to see and add every component and crafting material."
                           Foreground="{DynamicResource WarningForegroundBrush}"
                           Visibility="{Binding IsDatabaseMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="Some amounts are not valid (marked red): enter whole numbers from 0 to 999,999."
                           Foreground="{DynamicResource ErrorForegroundBrush}"
                           Visibility="{Binding HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="11"
                           Text="Reading material names and icons…"
                           Foreground="{StaticResource DollSecondaryTextBrush}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <!-- The two pages of the Smuggler's window. -->
            <TabControl Style="{StaticResource UnderlineTabControlStyle}" Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabItem Header="Components">
                    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Margin="0,6,0,0"
                                      Focusable="False"
                                      ItemsSource="{Binding Components}"
                                      ItemsPanel="{StaticResource MaterialPanel}"
                                      ItemTemplate="{StaticResource MaterialTemplate}" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Crafting materials">
                    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Margin="0,6,0,0"
                                      Focusable="False"
                                      ItemsSource="{Binding CraftingMaterials}"
                                      ItemsPanel="{StaticResource MaterialPanel}"
                                      ItemTemplate="{StaticResource MaterialTemplate}" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>

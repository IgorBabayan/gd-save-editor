<UserControl x:Class="GD.SaveEditor.Presentation.Views.Stash.StashView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:stashVm="using:GD.SaveEditor.Presentation.ViewModels.Stash"
             xmlns:local="using:GD.SaveEditor.Presentation.Views.Stash"
             mc:Ignorable="d"
             x:DataType="stashVm:StashViewModel"
             d:DesignHeight="800" d:DesignWidth="900">

    <!--
        "Stash" tab: the personal stash (tabs 1 to 8; the ones not bought in the game are locked), the shared stash and
        the Smuggler's material storage of every character of the same mode, side by side when there is room. Items can
        be moved inside each stash and amounts of materials changed; changes are written on Save (the shared stash into
        transfer.gst / transfer.gsh, the materials into reagents.gst / reagents.gsh).
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <local:StashGroupView DataContext="{Binding Personal}" />
            <!-- Hidden while there is no shared stash. -->
            <local:StashGroupView DataContext="{Binding Transfer}" IsVisible="{Binding $parent[local:StashView].((stashVm:StashViewModel)DataContext).HasTransfer}" />

            <!-- The Smuggler's Components and Crafting materials pages (game version 1.3+), shared like the stash. -->
            <local:MaterialStorageView DataContext="{Binding Materials}" IsVisible="{Binding $parent[local:StashView].((stashVm:StashViewModel)DataContext).HasMaterials}" />
        </WrapPanel>
    </ScrollViewer>
</UserControl>
